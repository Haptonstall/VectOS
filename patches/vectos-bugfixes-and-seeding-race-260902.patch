diff --git a/core/data/src/main/java/com/lz/data/persistence/room/seeder/DatabaseSeedingCoordinator.kt b/core/data/src/main/java/com/lz/data/persistence/room/seeder/DatabaseSeedingCoordinator.kt
new file mode 100644
index 0000000..86fe049
--- /dev/null
+++ b/core/data/src/main/java/com/lz/data/persistence/room/seeder/DatabaseSeedingCoordinator.kt
@@ -0,0 +1,49 @@
+package com.lz.data.persistence.room.seeder
+
+import kotlinx.coroutines.CompletableDeferred
+import javax.inject.Inject
+import javax.inject.Singleton
+
+/**
+ * Lets any consumer `await()` for [VectosApplication]'s one-shot database
+ * seeding pass to finish before it does its own first one-shot read of
+ * seeded reference data (building codes, materials, sections, load
+ * combinations).
+ *
+ * Why this exists: [VectosApplication.seedDatabase] deliberately runs on a
+ * fire-and-forget `applicationScope.launch` — it's real disk I/O on a cold
+ * install, and blocking `Application.onCreate()` on it risks an ANR. But
+ * `MainActivity`/any ViewModel can start composing immediately after
+ * `Application.onCreate()` returns, with no guarantee seeding has finished.
+ * The reference-data reads on the consumer side (`getAllBuildingCodes()`,
+ * etc.) are one-shot suspend calls, not observed Flows, so losing this race
+ * doesn't self-heal — it leaves the relevant list empty for the rest of the
+ * app session.
+ *
+ * Invisible on the emulator: its seeders are idempotent and the emulator
+ * install is typically already seeded from many prior test runs. A genuine
+ * first/cold launch on real hardware is exactly when this race is most
+ * likely to actually be lost.
+ *
+ * Usage: [VectosApplication.seedDatabase] marks this complete (success OR
+ * failure — a failed seed still means "seeding is done, stop waiting") in a
+ * `finally` block. Any one-shot reader of seeded data calls
+ * `databaseSeedingCoordinator.awaitSeeded()` before its first read.
+ */
+@Singleton
+class DatabaseSeedingCoordinator @Inject constructor() {
+
+    private val seeded = CompletableDeferred<Unit>()
+
+    /** Suspends until seeding has finished (successfully or not). No-op if already complete. */
+    suspend fun awaitSeeded() {
+        seeded.await()
+    }
+
+    /** Marks seeding as finished, releasing every current/future [awaitSeeded] caller. Idempotent. */
+    fun markSeeded() {
+        if (!seeded.isCompleted) {
+            seeded.complete(Unit)
+        }
+    }
+}
