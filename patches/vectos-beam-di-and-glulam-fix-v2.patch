@@ -0,0 +1,53 @@
+package com.lz.beam.di
+
+import com.lz.data.persistence.room.AppDatabase
+import com.lz.data.repository.CalculationWriter
+import com.lz.data.repository.IStructuralCodeRepository
+import com.lz.domain.material.MaterialRepository
+import com.lz.domain.project.ActiveProjectProvider
+import com.lz.domain.repository.ProjectRepository
+import com.lz.model.structural.SectionRepository
+import dagger.hilt.EntryPoint
+import dagger.hilt.InstallIn
+import dagger.hilt.android.EntryPointAccessors
+import dagger.hilt.components.SingletonComponent
+import android.content.Context
+
+/**
+ * Hilt's @HiltViewModel / hiltViewModel() cannot see classes declared inside
+ * a dynamic-feature module — the app module's Hilt component graph is
+ * generated when :app itself compiles, which happens BEFORE feature/beam
+ * (dynamic-feature modules intentionally depend on :app, not the reverse,
+ * so :app never has feature/beam on its compile classpath).
+ *
+ * This EntryPoint is the standard workaround: it lets feature/beam pull
+ * already-bound dependencies out of :app's SingletonComponent manually,
+ * for use in a hand-written ViewModelProvider.Factory (see
+ * BeamViewModelFactory) instead of relying on Hilt's ViewModel injection.
+ */
+@EntryPoint
+@InstallIn(SingletonComponent::class)
+interface BeamEntryPoint {
+
+    fun activeProjectProvider(): ActiveProjectProvider
+
+    fun structuralCodeRepository(): IStructuralCodeRepository
+
+    fun sectionRepository(): SectionRepository
+
+    fun materialRepository(): MaterialRepository
+
+    fun calculationWriter(): CalculationWriter
+
+    fun projectRepository(): ProjectRepository
+
+    fun appDatabase(): AppDatabase
+
+    companion object {
+        fun from(context: Context): BeamEntryPoint =
+            EntryPointAccessors.fromApplication(
+                context.applicationContext,
+                BeamEntryPoint::class.java
+            )
+    }
+}
