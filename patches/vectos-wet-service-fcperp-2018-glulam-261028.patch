+        val r = cm(wood(WoodSpecies.DF_L, WoodGrade.NO_2), lumber(2, 10, 1.5, 9.25), dry)
+        listOf(r.cmFb, r.cmFt, r.cmFv, r.cmFcPerp, r.cmFc, r.cmE).forEach { assertEquals(1.0, it, 0.0) }
+        assertTrue(!r.isWet)
+    }
+
