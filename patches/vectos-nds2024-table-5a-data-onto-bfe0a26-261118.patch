+        assertEquals(listOf(Nds2024Table5A.Marker("fbxNeg", listOf(2)), Nds2024Table5A.Marker("fvx", listOf(3)), Nds2024Table5A.Marker("fvy", listOf(3)), Nds2024Table5A.Marker("g", listOf(10))).toSet(),
