+        assertEquals(listOf(1700, 900, 205), listOf(f.fby, f.fcy, f.fvy))
+        assertEquals(listOf(1100, 1450), listOf(f.ft, f.fc))
+        assertEquals(0.63, f.specificGravity, 0.0)
+    }
